{
  "info": {
    "name": "Aforro Backend Assignment (Round-2)",
    "description": "Stores, inventory, orders, and product search/autocomplete APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "store_id", "value": "1" },
    { "key": "product_id", "value": "1" }
  ],
  "item": [
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/orders/", "host": ["{{base_url}}"], "path": ["orders", ""] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"store_id\": {{store_id}},\n  \"items\": [\n    { \"product_id\": {{product_id}}, \"quantity_requested\": 1 }\n  ]\n}"
        }
      }
    },
    {
      "name": "List Store Orders",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/stores/{{store_id}}/orders/",
          "host": ["{{base_url}}"],
          "path": ["stores", "{{store_id}}", "orders", ""]
        }
      }
    },
    {
      "name": "List Store Inventory",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/stores/{{store_id}}/inventory/",
          "host": ["{{base_url}}"],
          "path": ["stores", "{{store_id}}", "inventory", ""]
        }
      }
    },
    {
      "name": "Search Products",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/search/products/?category=Electronics&price_min=10&price_max=100&store_id={{store_id}}&in_stock=true&sort=relevance",
          "host": ["{{base_url}}"],
          "path": ["api", "search", "products", ""],
          "query": [
            { "key": "category", "value": "Electronics" },
            { "key": "price_min", "value": "10" },
            { "key": "price_max", "value": "100" },
            { "key": "store_id", "value": "{{store_id}}" },
            { "key": "in_stock", "value": "true" },
            { "key": "sort", "value": "relevance" }
          ]
        }
      }
    },
    {
      "name": "Autocomplete Suggest",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/search/suggest/?q=Adv",
          "host": ["{{base_url}}"],
          "path": ["api", "search", "suggest", ""],
          "query": [{ "key": "q", "value": "Adv" }]
        }
      }
    }
  ]
}
